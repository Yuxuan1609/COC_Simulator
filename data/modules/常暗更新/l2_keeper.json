  "npc_profiles": {
    "京山人吉": {
      "name": "京山人吉",
      "role": "重伤濒死的电车乘务员，掌握怪物弱点与钥匙位置的关键信息，求生欲与职业责任感交织。",
      "what_they_can_do": "京山人吉在玩家进入4号车厢时被发现昏迷倒地，若受到急救，他将苏醒并用尽最后的力气提供关键信息：警告后方出现的怪物惧怕强光或巨大声响等弱点，并指出自己掉在前方3号车厢前门附近的黑色背包里藏有驾驶室钥匙，恳求玩家尽快停车逃离。若玩家带上他同行，他会尽力跟随但动作迟缓，进入3号车厢时会主动指出背包位置。若被留在后方，他将被吞噬，并在死亡前发出惨叫。在驾驶室，他会强烈反对让电车加速，主张立刻停车。",
      "interaction_triggers": [
        "调查员进入4号车厢时，发现重伤昏迷的京山人吉。",
