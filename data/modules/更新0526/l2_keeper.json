  "events": [
    {
      "id": "E1",
      "type": "无",
      "name": "吞噬的迫近",
      "requirement": "I5",
      "trigger": "调查员打开7号车厢门，目睹那张巨口后，黑暗从后方开始明显地蚕食车厢。",
      "result": "不可逆：从此刻起，后方的车厢将逐渐被巨口吞噬，6号车厢开始缓慢消失。若调查员在非先头车厢停留时间过长，黑暗将追上他们，##END_结局C:疯狂收容## 调查员被巨口吞噬，在现实的精神病院中醒来，被判定为极度疯狂，关在隔离室，余生都在逃避那个无人知晓具体内容的恐怖梦魇。",
      "side_effects": [
        "时间压力增加"
      ],
      "graded_result": null,
      "difficulty": "None"
    },
    {
      "id": "E2",
      "type": "无",
      "name": "6号车厢的退缩",
      "requirement": "I7",
      "trigger": "调查员在5号车厢进行观察时，发现6号车厢已将近一半消失在了黑暗中，立足点正在缓慢缩减。",
      "result": "不可逆：6号车厢部分消失，不再完整，且消失仍在继续。返回6号车厢将变得危险或不可能。",
      "side_effects": [
        "后路断绝对调查员造成心理压力。"
      ],
      "graded_result": null,
      "difficulty": "None"
    },
    {
      "id": "E3",
      "type": "无",
      "name": "乘务员苏醒",
      "requirement": "I8",
      "trigger": "成功急救后，重伤的乘务员从昏迷中苏醒。",
      "result": "乘务员恢复意识，状态稳定，能够交流并提供信息。",
