  "boss_encounters": [
    {
      "id": "BOSS_1",
      "type": "boss_encounter",
      "engage_type": "at",
      "boss_ref": "吞噬之口",
      "scene": "7号车厢",
      "requirements": "(I5)",
      "description": "你猛地拉开车门，一股浓烈的血腥味和金属摩擦的尖啸扑面而来。在你的眼前，整节7号车厢的后半部分已经消失，取而代之的是一张巨大的、布满利齿的嘴巴，正从黑暗中缓缓逼近，边缘无数眼睛冷漠地注视着你们。车厢地板在剧烈颤抖，钢铁扭曲的声音刺痛耳膜，那张巨口正将车厢的残骸连同空气一并吸入。你意识到，如果再不逃离，你们将成为它的下一顿美餐。"
    }
  ],
  "npc_profiles": {
    "乘务员": {
      "name": "乘务员",
      "role": "受伤的电车乘务员，关键情报提供者",
      "what_they_can_do": "乘务员腿部严重受伤，初始处于休克半昏迷状态。如果调查员成功进行急救，他会苏醒。苏醒后，他将告知调查员：后方有依靠听觉捕猎的怪物，钥匙藏在第三个箱子里，并请求调查员停下电车逃离。如果得知后方也有巨口吞噬车厢，他会陷入两难，最终可能协助调查员做出决定。由于腿部受伤，他行动困难，但可以在他人搀扶下缓慢移动。",
      "interaction_triggers": [
        "调查员发现受伤的乘务员并尝试急救",
        "调查员与苏醒的乘务员交谈询问情报",
        "调查员告知乘务员后方巨口的存在"
      ],
      "personality_notes": "原本尽责，受伤后求生与职责感交织。说话虚弱但条理清晰，带有紧迫感。得知绝境时可能流露出绝望与犹豫。",
      "can_follow": true,
